
{% liquid
  assign policy = product.metafields.custom.return_exchange_policy.value
%}

{% if policy != blank %}
  <section
    id="return-policy-{{ section.id }}"
    class="return-policy-section"
  >
    <div class="return-policy-container">

      <h2 class="return-policy-heading">
        {{ section.settings.heading | escape }}
      </h2>

      {% if policy.policy_name.value != blank %}
        <h3 class="return-policy-name">
          {{ policy.policy_name.value | escape }}
        </h3>
      {% endif %}

      <div class="return-policy-details">

        <div class="return-policy-item">
          <span class="return-policy-label">Returns</span>

          {% if policy.return_eligible.value %}
            <span class="return-policy-status eligible">
              Eligible
            </span>
            {% if policy.return_period_days.value != blank %}
              <span class="return-policy-description">
                Within {{ policy.return_period_days.value }} days
              </span>
            {% endif %}
          {% else %}
            <span class="return-policy-status not-eligible">
              Not eligible
            </span>
          {% endif %}
        </div>

        <div class="return-policy-item">
          <span class="return-policy-label">Exchanges</span>

          {% if policy.exchange_eligible.value %}
            <span class="return-policy-status eligible">
              Eligible
            </span>
          {% else %}
            <span class="return-policy-status not-eligible">
              Not eligible
            </span>
          {% endif %}
        </div>

      </div>

      {% if policy.terms_conditions.value != blank %}
        <details class="return-policy-terms">
          <summary>Terms & Conditions</summary>

          <div class="return-policy-terms-content">
            {{ policy.terms_conditions.value | escape | newline_to_br }}
          </div>
        </details>
      {% endif %}

    </div>
  </section>
{% endif %}

{% stylesheet %}
  .return-policy-section {
    margin-block: 32px;
    padding: 24px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 12px;
  }

  .return-policy-heading {
    margin: 0 0 16px;
    font-size: 22px;
  }

  .return-policy-name {
    margin: 0 0 20px;
    font-size: 17px;
    font-weight: 600;
  }

  .return-policy-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .return-policy-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.035);
    border-radius: 8px;
  }

  .return-policy-label {
    font-weight: 600;
  }

  .return-policy-status {
    font-size: 14px;
    font-weight: 600;
  }

  .return-policy-status.eligible {
    color: #16803c;
  }

  .return-policy-status.not-eligible {
    color: #b42318;
  }

  .return-policy-description {
    font-size: 13px;
    opacity: 0.75;
  }

  .return-policy-terms {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .return-policy-terms summary {
    cursor: pointer;
    font-weight: 600;
  }

  .return-policy-terms-content {
    margin-top: 12px;
    line-height: 1.7;
    white-space: normal;
  }

  @media screen and (max-width: 600px) {
    .return-policy-details {
      grid-template-columns: 1fr;
    }

    .return-policy-section {
      padding: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Return & Exchange Policy",
  "tag": "section",
  "class": "return-exchange-policy-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Return & Exchange Policy"
    }
  ],
  "presets": [
    {
      "name": "Return & Exchange Policy"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
