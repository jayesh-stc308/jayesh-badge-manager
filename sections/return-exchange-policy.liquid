{% liquid
  assign policy = product.metafields.custom.return_exchange_policy.value
%}

{% if policy != blank %}
  <section
    id="return-policy-{{ section.id }}"
    class="return-policy-section"
  >
    <div class="return-policy-container">
      <!-- Section Header -->
      <div class="return-policy-header">
        <div class="return-policy-header-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="23"
            height="23"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 12a9 9 0 1 0 2.64-6.36L3 8"/>
            <path d="M3 3v5h5"/>
            <path d="M12 7v5l3 2"/>
          </svg>
        </div>

        <div>
          <h2 class="return-policy-heading">
            {{ section.settings.heading | escape }}
          </h2>
          <p class="return-policy-subheading">Shop with confidence. Here's everything you need to know.</p>
        </div>
      </div>

      <!-- Policy Name -->
      {% if policy.policy_name.value != blank %}
        <div class="return-policy-name">
          {{ policy.policy_name.value | escape }}
        </div>
      {% endif %}

      <!-- Policy Information Cards -->
      <div class="return-policy-details">
        <!-- Return Card -->
        <div class="return-policy-card">
          <div class="return-policy-card-icon return-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 7v6h6"/>
              <path d="M21 17a9 9 0 0 0-15.5-6.5L3 13"/>
            </svg>
          </div>

          <div class="return-policy-card-content">
            <span class="return-policy-label">Returns</span>

            {% if policy.return_eligible.value %}
              <span class="return-policy-status eligible">
                <span class="status-dot"></span>
                Returns Accepted
              </span>

              {% if policy.return_period_days.value != blank %}
                <p class="return-policy-description">
                  Return within
                  <strong>{{ policy.return_period_days.value }} days</strong>
                  of purchase.
                </p>
              {% endif %}
            {% else %}
              <span class="return-policy-status not-eligible">
                <span class="status-dot"></span>
                Returns Not Accepted
              </span>
              <p class="return-policy-description">This product is not eligible for returns.</p>
            {% endif %}
          </div>
        </div>

        <!-- Exchange Card -->
        <div class="return-policy-card">
          <div class="return-policy-card-icon exchange-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m16 3 4 4-4 4"/>
              <path d="M20 7H4"/>
              <path d="m8 21-4-4 4-4"/>
              <path d="M4 17h16"/>
            </svg>
          </div>

          <div class="return-policy-card-content">
            <span class="return-policy-label">Exchanges</span>

            {% if policy.exchange_eligible.value %}
              <span class="return-policy-status eligible">
                <span class="status-dot"></span>
                Exchanges Accepted
              </span>
              <p class="return-policy-description">Exchange options are available for this product.</p>
            {% else %}
              <span class="return-policy-status not-eligible">
                <span class="status-dot"></span>
                Exchanges Not Accepted
              </span>
              <p class="return-policy-description">This product is not eligible for exchanges.</p>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Terms & Conditions -->
      {% if policy.terms_conditions.value != blank %}
        <details class="return-policy-terms">
          <summary>
            <span class="terms-summary-content">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <path d="M14 2v6h6"/>
                <path d="M8 13h8"/>
                <path d="M8 17h8"/>
              </svg>
              Terms & Conditions
            </span>

            <svg
              class="terms-chevron"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </summary>

          <div class="return-policy-terms-content">
            {{ policy.terms_conditions.value | escape | newline_to_br }}
          </div>
        </details>
      {% endif %}

      <!-- Footer -->
      <div class="return-policy-footer">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>We want you to shop with confidence.</span>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .return-policy-section {
    margin-block: 32px;
    padding: 30px;
    background: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 14px;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.035);
  }

  .return-policy-container {
    max-width: 100%;
  }

  /* Header */

  .return-policy-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 22px;
  }

  .return-policy-header-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333333;
    background: #f4f4f4;
    border-radius: 12px;
  }

  .return-policy-heading {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 650;
    color: #202020;
  }

  .return-policy-subheading {
    margin: 5px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: #777777;
  }

  /* Policy Name */

  .return-policy-name {
    margin-bottom: 16px;
    padding: 12px 15px;
    background: #f8f8f8;
    border-radius: 8px;
    color: #333333;
    font-size: 14px;
    font-weight: 600;
  }

  /* Information Cards */

  .return-policy-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .return-policy-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px;
    background: #fafafa;
    border: 1px solid #eeeeee;
    border-radius: 11px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .return-policy-card:hover {
    border-color: #d8d8d8;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.035);
  }

  .return-policy-card-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
  }

  .return-icon {
    color: #386baf;
    background: #eaf1fc;
  }

  .exchange-icon {
    color: #8a60b5;
    background: #f2ebfa;
  }

  .return-policy-card-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    min-width: 0;
  }

  .return-policy-label {
    font-size: 15px;
    font-weight: 650;
    color: #252525;
  }

  /* Status */

  .return-policy-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 9px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 650;
    line-height: 1.3;
  }

  .return-policy-status.eligible {
    color: #207443;
    background: #e9f6ed;
  }

  .return-policy-status.not-eligible {
    color: #a33a36;
    background: #fbeceb;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: currentColor;
  }

  .return-policy-description {
    margin: 0;
    color: #777777;
    font-size: 12px;
    line-height: 1.6;
  }

  .return-policy-description strong {
    color: #333333;
    font-weight: 650;
  }

  /* Terms & Conditions */

  .return-policy-terms {
    margin-top: 18px;
    border: 1px solid #eaeaea;
    border-radius: 10px;
    overflow: hidden;
  }

  .return-policy-terms summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    cursor: pointer;
    list-style: none;
    color: #292929;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .return-policy-terms summary::-webkit-details-marker {
    display: none;
  }

  .return-policy-terms summary:hover {
    background: #f8f8f8;
  }

  .terms-summary-content {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .terms-chevron {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .return-policy-terms[open] .terms-chevron {
    transform: rotate(180deg);
  }

  .return-policy-terms-content {
    padding: 16px 18px;
    border-top: 1px solid #eeeeee;
    color: #666666;
    font-size: 13px;
    line-height: 1.8;
  }

  /* Footer */

  .return-policy-footer {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    color: #777777;
    font-size: 12px;
  }

  .return-policy-footer svg {
    flex-shrink: 0;
    color: #43845b;
  }

  /* Responsive */

  @media screen and (max-width: 749px) {
    .return-policy-section {
      margin-block: 24px;
      padding: 20px;
      border-radius: 11px;
    }

    .return-policy-heading {
      font-size: 19px;
    }

    .return-policy-header-icon {
      width: 42px;
      height: 42px;
    }

    .return-policy-details {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .return-policy-card {
      padding: 16px;
    }
  }

  @media screen and (max-width: 400px) {
    .return-policy-section {
      padding: 15px;
    }

    .return-policy-header {
      gap: 10px;
    }

    .return-policy-subheading {
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Return & Exchange Policy",
  "tag": "section",
  "class": "return-exchange-policy-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Return & Exchange Policy"
    }
  ],
  "presets": [
    {
      "name": "Return & Exchange Policy"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
